# =============================================================================
# SEO Agent — environment configuration (TEMPLATE)
# Copy to `.env` and fill in values:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# In staging/production, inject these from a secret manager instead of a file.
# Empty values fall back to the defaults in src/config.py.
# =============================================================================

# ── 1. Target website ────────────────────────────────────────────────────────
# Domain the agents analyse. A full URL also works ("https://" and any path are
# stripped; "www." is kept). Override for a single run: --site example.com
TARGET_SITE=machinoai.in

OUTPUT_DIR=data/output

#2. Providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
INCEPTION_API_KEY=

# Google data sources
# PageSpeed Insights / CrUX API key
PAGESPEED_API_KEY=

# Path to the Search Console service-account JSON (keep the file outside git)
GSC_SERVICE_ACCOUNT_FILE=
# Protects the HTTP API (send it as the X-API-Key header). Blank = no auth, local use only
API_KEY=

# ── 3. LLM (LangChain) — default for every agent ─────────────────────────────
# Provider: openai | anthropic | gemini | inception
LLM_PROVIDER=anthropic
# Blank = provider default: openai=gpt-5.5, anthropic=claude-sonnet-5-5,
# gemini=gemini-3.8-flash, inception=mercury-3
LLM_MODEL=
LLM_REASONING=medium
LLM_TEMPERATURE=


LLM_MAX_TOKENS=16384
LLM_TIMEOUT_SECONDS=120
# Retries per LLM call: 1 = at most 2 tries
LLM_MAX_RETRIES=1
# Extra or corrected token prices, USD per 1M tokens: {"model": [input, cached_input, output]}
# Built-in list prices (Nov 2026) cover OpenAI, Anthropic, Gemini and Mercury models.
LLM_PRICES=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# ── 4. Per-agent LLM overrides (optional; blank = use section 3) ─────────────
# Pattern: <AGENT>_LLM_{PROVIDER,MODEL,REASONING,TEMPERATURE,MAX_TOKENS}
# Switching an agent's PROVIDER without setting its MODEL uses that provider's default.
SEO_AUDIT_LLM_PROVIDER=
SEO_AUDIT_LLM_MODEL=
SEO_AUDIT_LLM_REASONING=

KEYWORD_RESEARCH_LLM_PROVIDER=
KEYWORD_RESEARCH_LLM_MODEL=
KEYWORD_RESEARCH_LLM_REASONING=

CONTENT_STRATEGY_LLM_PROVIDER=
CONTENT_STRATEGY_LLM_MODEL=
CONTENT_STRATEGY_LLM_REASONING=

PERFORMANCE_REPORTING_LLM_PROVIDER=
PERFORMANCE_REPORTING_LLM_MODEL=
PERFORMANCE_REPORTING_LLM_REASONING=

# ── 5. Embeddings (provider still open) ──────────────────────────────────────
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ── 6. Application ───────────────────────────────────────────────────────────
# local | staging | production
APP_ENV=local
APP_NAME=seo-agent
LOG_LEVEL=INFO
# true = JSON logs (use in staging/production), false = human-readable console
LOG_JSON=false
# Rotating JSON log file (10 MB x 5); each run also writes run.log in its run folder
LOG_FILE=data/logs/seo_agent.log
API_HOST=0.0.0.0
API_PORT=8000

# ── 7. Database (local SQLite file — no server needed) ───────────────────────
# Production: postgresql+psycopg://user:password@host:5432/seo_agent
#   (install the driver with: pip install -e ".[postgres]")
DATABASE_URL=sqlite+aiosqlite:///data/seo_agent.db
# Apply database migrations automatically on startup (set false in production)
AUTO_MIGRATE=true

# ── 8. Crawler limits ────────────────────────────────────────────────────────
CRAWLER_USER_AGENT="SEOAgentBot/0.1"
CRAWLER_MAX_PAGES=500
CRAWLER_MAX_DEPTH=5
CRAWLER_CONCURRENCY=4
# Exponential backoff: normal pause before each request (seconds). Every 429/5xx/network
# error doubles it: 1 -> 2 -> 4 -> 8 -> 16 -> 30 s (cap below); each healthy page halves it
# back. After 10 errors in a row the crawl pauses 60 s, then stops early if still failing.
CRAWLER_DELAY_SECONDS=1
CRAWLER_MAX_DELAY_SECONDS=30
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_MAX_RESPONSE_BYTES=5000000
# Tries per HTTP request (pages, PageSpeed, Search Console): 2 = one try + one retry.
# After the last try the failure is recorded and the crawl moves to the next page.
HTTP_MAX_ATTEMPTS=2

# ── 9. Data sources ──────────────────────────────────────────────────────────
# Priority pages measured with PageSpeed Insights per run (works without a key, low quota)
PAGESPEED_MAX_URLS=5
# Search Console property; blank = try sc-domain:<site>, then https://<site>/
GSC_PROPERTY=
GSC_LOOKBACK_DAYS=28
